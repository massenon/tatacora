APP_NAME=TATACORA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Contenu visible utilisateur en francais (00_MASTER_INSTRUCTIONS.md §7)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de donnees — MySQL 8.0.16+ / MariaDB 10.2.1+ EXIGE (ADR-000 §2.2)
# La version minimale conditionne le support natif des contraintes CHECK
# utilisees dans le schema (FULL_MIGRATIONS_DATABASE.md §2). En dessous, les
# contraintes sont ignorees SILENCIEUSEMENT : aucune erreur, aucune integrite.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tatacora_dev
DB_USERNAME=root
DB_PASSWORD=

# API consommee par le client Flutter : jetons Sanctum, pas de session cookie
# (02_SOFTWARE_ARCHITECTURE.md §3.1). Aucune table `sessions` dans le schema.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Files d'attente : certification MECeF, notifications WhatsApp/SMTP
# (02_SOFTWARE_ARCHITECTURE.md §7 — rejeu automatique en cas d'indisponibilite)
QUEUE_CONNECTION=database

CACHE_STORE=database

# Messagerie « Contactez l'editeur » (directive PO du 14/10/2026) : SMTP reel,
# port 587 + STARTTLS (MAIL_SCHEME=smtp negocie le TLS ; smtps = SSL 465).
# Le MOT DE PASSE ne vit QUE dans le .env du poste — jamais dans le code ni
# dans parametres_systeme. Vide : les messages restent « en attente d'envoi »
# et `php artisan contact-editeur:rejouer` (planifiee chaque heure) les renvoie.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.logirestock.digitonpro.com
MAIL_PORT=587
MAIL_USERNAME=contact@logirestock.digitonpro.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@logirestock.digitonpro.com"
MAIL_FROM_NAME="${APP_NAME}"
# Destinataire du support de l'editeur.
SUPPORT_MAIL=rarhodes06@gmail.com

# ===========================================================================
# SECRETS TECHNIQUES — jamais en base, jamais dans parametres_systeme
# (00_MASTER_INSTRUCTIONS.md §3 principe 6, A1_MASTER_PROMPT.md §2.4)
#
# Les valeurs ci-dessous sont des marqueurs volontairement NON FONCTIONNELS.
# Ne jamais les remplacer par une valeur plausible dans ce fichier d'exemple :
# seul le .env reel (non versionne) porte les vraies cles.
#
# La bascule Fake/Reel des services depend de la PRESENCE de ces cles en
# configuration serveur (MecefServiceProvider / WhatsAppServiceProvider),
# jamais d'un parametre lisible en base par un Administrateur.
# ===========================================================================

# MECeF / DGI Benin — certification des factures (MECEF_INTEGRATION_SPEC.md)
# Inscription non initiee a ce jour : PA-17, delai annonce jusqu'a 72h.
# Tant que la cle est absente, MecefClientFake prend le relais (§6 du document).
MECEF_BASE_URL=CHANGE_ME_MECEF_BASE_URL
MECEF_API_KEY=CHANGE_ME_MECEF_API_KEY
MECEF_IFU=CHANGE_ME_IFU_ENTREPRISE

# WhatsApp Business Cloud API (Meta) — notifications sortantes UNIQUEMENT.
# Jamais un canal de saisie (RG-20).
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_WHATSAPP_VERIFY_TOKEN

# Sanctum — domaines autorises pour le client Flutter
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
