# =============================================================================
# TATACORA AFRIQUE — gabarit .env de PRODUCTION (logirestock.digitonpro.com)
#
# Copier en `.env` SUR LE SERVEUR et remplir chaque <…>. Ce fichier gabarit ne
# contient AUCUN secret et ne doit jamais en contenir : les valeurs réelles ne
# vivent que dans le `.env` du serveur, jamais dans git.
# Procédure complète : docs/DEPLOIEMENT_LOGIRESTOCK.md
# =============================================================================

APP_NAME="TATACORA AFRIQUE"
APP_ENV=production
APP_KEY=            # php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://logirestock.digitonpro.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=error

# --- Base MySQL (cPanel) -----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<base_cpanel>
DB_USERNAME=<utilisateur_cpanel>
DB_PASSWORD=<mot_de_passe_base>

# --- Sessions / cache / files (cPanel mutualisé : pas de Redis) --------------
SESSION_DRIVER=database
# 480 min = une journee de service (audit PO du 01/09/2026) : les ecrans de
# POS maintiennent en plus la session par battement tant qu'un panier est
# ouvert ou la caisse non cloturee (partials/maintien-session.blade.php).
SESSION_LIFETIME=480
# Cookie de session reserve a https (defaut deja sur hors local/testing) et
# proxys de confiance : sans eux, derriere le proxy de l'hebergeur, le jeton
# CSRF se desynchronise (« Page Expired »). Voir docs/VERIFICATIONS_APRES_MISE_EN_PRODUCTION.md.
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- SMTP (fourni par le Product Owner le 01/09/2026) ------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.logirestock.digitonpro.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=contact@logirestock.digitonpro.com
MAIL_PASSWORD=<mot_de_passe_smtp>
MAIL_FROM_ADDRESS=contact@logirestock.digitonpro.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Comptes réels (ComptesReelsSeeder, PA-167) ------------------------------
# Lues UNE fois par `php artisan db:seed --class=ComptesReelsSeeder`.
# Un mot de passe ne vit JAMAIS dans le code ni dans git — seulement ici.
# Après l'amorçage, ces trois lignes PEUVENT être retirées du .env.
COMPTE_RODRIGUE_MOT_DE_PASSE=<…>
COMPTE_BIENVENU_MOT_DE_PASSE=<…>
COMPTE_NOEL_MOT_DE_PASSE=<…>
COMPTE_SUPER_ADMIN_MOT_DE_PASSE=<…>
# Rôles (facultatif — défauts : rodrigue=administrateur, bienvenu=gerant, noel=gerant)
# COMPTE_RODRIGUE_ROLE=administrateur
# COMPTE_BIENVENU_ROLE=gerant
# COMPTE_NOEL_ROLE=gerant

# --- MECeF (PA-17 : inscription DGI non lancée — mode démonstration) ---------
# Aucune clé ici tant que l'inscription DGI n'a pas abouti. Le jour venu, la
# clé va ICI, jamais dans parametres_systeme (lisible par tout Administrateur).
# MECEF_API_KEY=
